    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhateverScanner verbindet sich mit Servern in deinem lokalen Netzwerk (z. B. einem NAS per SMB oder WebDAV), um deine gescannten Dokumente hochzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WhateverScanner connects to servers on your local network (e.g. a NAS via SMB or WebDAV) to upload your scanned documents."
          }
        }
      }
    },
